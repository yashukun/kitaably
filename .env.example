# =============================================================================
# Kitaably — copy to .env and fill in.  .env is gitignored and must stay that way.
# Values marked (supabase) are printed by `supabase start`.
# Keep comments on their own line: Compose does not reliably strip trailing ones.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_NAME=Kitaably
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Supabase ----------------------------------------------------------------
# Local: the Supabase CLI stack. Deployed: your hosted project's URL and keys.
# host.docker.internal is how a compose container reaches the CLI stack on the host.
SUPABASE_URL=http://host.docker.internal:54321
# (supabase) publishable key — safe in a browser
SUPABASE_ANON_KEY=
# (supabase) service role key — BYPASSES RLS. Backend and worker only. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
BUCKET_BOOKS=books
BUCKET_EVIDENCE=evidence

# --- Database ----------------------------------------------------------------
# (supabase) DB URL rewritten for asyncpg. 54322 is the CLI stack's Postgres port.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Embeddings service ------------------------------------------------------
EMBEDDINGS_URL=http://embeddings:8001
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
# ONNX Runtime's CPU arena allocator. Off, because on this workload it is a leak: it
# grows by doubling, never returns memory, and was measured holding 4.95 GiB of an
# 11.67 GiB Docker VM for a 33M-parameter model. Ollama shares that VM, so the arena
# starved the model server — generation fell to 0.47 tok/s against the 16.5 D21
# measured, and every assessment call timed out mid-JSON. Turn it on only if this
# service is embedding continuously rather than in bursts at ingest.
EMBEDDING_CPU_MEM_ARENA=false
# The model's sequence limit. It TRUNCATES past this rather than erroring, so a
# longer chunk is indexed on its first 512 tokens and the rest is unsearchable.
# CHUNK_TOKENS must stay under it. Changing the model means changing this.
EMBEDDING_MAX_TOKENS=512
# bge is asymmetric: passages are embedded bare, questions behind this instruction.
# Blank it for a symmetric embedding model.
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages:"

# --- LLM (OpenAI-compatible) -------------------------------------------------
# Local:    http://host.docker.internal:11434/v1  -> Ollama on YOUR machine
# Deployed: https://api.openai.com/v1              with a real key
#
# **Run Ollama on the host, not in the container.** `make setup-llm` pulls the models;
# `ollama serve` (or the menu-bar app) keeps it listening on 11434.
#
# Why the host: Docker Desktop on Apple Silicon runs a Linux VM that CANNOT see the
# Mac's GPU -- `ls /dev/dri` inside the container is empty -- so a containerised Ollama
# is CPU-only inside a guest, while the host's uses Metal across every GPU core.
# Measured here on the same model and the same prompt: host 9.4 tok/s, container could
# not finish 60 tokens in 170 seconds. Roughly 21x, and the gap is hardware access
# rather than tuning, so no amount of CPU or memory allocation closes it.
#
# The compose stack therefore ships WITHOUT an ollama service (see docker-compose.yml).
# On Linux with a real GPU, running Ollama in a container is fine -- point this back at
# http://ollama:11434/v1 and restore the service.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama
# 3b, not 8b. On a CPU-only box the 8b generates at ~8 tok/s, which is roughly a
# minute of waiting for one tutor answer. Set this back to llama3.1:8b if you would
# rather have the quality than the speed — it is one variable (DECISIONS.md D21).
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Constrain replies that get parsed to a single JSON object, at the provider. Ollama
# and OpenAI both honour it; anything else 400s on the field and the client retries
# once without it. Measured: without this, five generation calls in eight came back
# as un-parseable JSON, each throwing away a minute or two of CPU decode.
LLM_JSON_MODE=true
# The model for work that runs in a worker instead of in front of a person: assessment
# generation, harvesting and grading. Blank = the same as LLM_MODEL.
#
# Chat has somebody watching the cursor, so it wants the fastest model that is good
# enough (D21 measured llama3.2:3b at 16.5 tok/s against llama3.1:8b at 8.2). Generation
# runs on the `llm` queue where nobody is watching and is judged on whether the
# distractors are plausible — so it is the one place where paying 2x wall clock for a
# better model is usually the right trade.
#
# BLANK on this box, and the blank is a measurement. qwen2.5:7b was tried and
# reverted: it generated at ~1 tok/s here against the 180s per-call timeout below, so
# every generation call timed out and papers came back empty. The cause was the Docker
# VM rather than the model — Ollama holding two models sat at 7.9 GiB of an 11.67 GiB
# VM while the host ran at ~2x oversubscription.
#
# Before setting this to anything bigger: pull it into the container
# (`docker compose exec ollama ollama pull <model>`), check
# `docker stats kitaably-ollama-1` sits well under the VM limit, and raise
# ASSESSMENT_LLM_TIMEOUT_SECONDS to match. NOT a reasoning model — see the note in
# backend/app/core/config.py for why <think> and JSON mode cannot both work here.
LLM_GENERATION_MODEL=
# Hard ceiling on a tutor answer. Generation is paid per token; uncapped, the model
# writes past the point the reader stopped reading. Structured callers (assessment
# generation, grading) are deliberately not capped and are unaffected by this.
LLM_MAX_ANSWER_TOKENS=500

# --- RAG tuning --------------------------------------------------------------
# Sized to the EMBEDDER (see EMBEDDING_MAX_TOKENS), not to taste. Raising this above
# ~410 puts chunks past what the model reads and silently drops their tails from the
# index. Changing it means re-ingesting every book: `make reingest`.
CHUNK_TOKENS=320
CHUNK_OVERLAP_TOKENS=64
# How many passages the tutor finally sees. This is a latency dial as much as a
# quality one — every passage is prompt the model must read before it writes a word.
RETRIEVAL_TOP_K=5
# How many the database returns before ranking narrows them. Chunk overlap means the
# top raw hits are routinely the same passage twice, so dedupe, the book vote and
# page spread all need more candidates than they will keep.
RETRIEVAL_CANDIDATE_K=30
# HNSW candidate list per search. pgvector post-filters, so a narrow scope filter on
# too small a list silently returns fewer rows than asked for.
RETRIEVAL_EF_SEARCH=120
# Tokens of each passage actually shown to the model. The chunk stays whole in the
# database, in the ranking and in the citation the reader opens — only the prompt copy
# is excerpted to the sentences bearing on the question. 0 sends passages whole.
RETRIEVAL_SOURCE_TOKENS=140
# Cosine distance ceiling for the first pass. Nothing inside it falls to the salvage
# tier below rather than straight to a refusal.
RETRIEVAL_MAX_DISTANCE=0.35
# When the first pass finds nothing, retrieval takes a second look before refusing:
# the reader's own selective words are looked up in the full-text index, and each
# passage they name is scored against the question as typed and kept only inside
# this ceiling. Not a wider search — a wider search cannot tell "barely covered"
# from "not covered" — but a check that the words and the meaning agree.
# Nothing survives → the refusal, with no model call, exactly as before.
RETRIEVAL_SALVAGE_DISTANCE=0.42
# Lexical candidates for a mention question ("find every mention of X"), fused with
# the vector hits (D22). Wider than TOP_K: the list of occurrences IS the product.
RETRIEVAL_LEXICAL_K=20
# Chat spends money or CPU on every call. Capped per user, per minute.
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Chat conversation -------------------------------------------------------
# Turns of transcript given to the tutor, and to the condenser that rewrites a
# follow-up into a standalone question. Six is three exchanges.
CHAT_HISTORY_TURNS=4
# Characters of each earlier ASSISTANT turn kept for continuity. The tutor needs to
# remember what it covered, not to re-read its own prose.
CHAT_HISTORY_REPLY_CHARS=240
# Share of the retrieval vote at which one book is treated as *the* source. Too low
# silently drops the book that had the answer, so it errs high.
CHAT_BOOK_DOMINANCE=0.62
# Passages for a whole-book question (overview) or holistic comparison, split across
# the target books. A latency dial like RETRIEVAL_TOP_K, spent on breadth.
CHAT_OVERVIEW_SOURCES=10
# Passages for a mention question after fusing lexical and vector hits.
CHAT_LOOKUP_SOURCES=8
# Most books one overview or comparison covers; the rest are named and deferred.
CHAT_MULTIBOOK_MAX=4
# Ask the model to label a message the rules could not — single ambiguous words
# and long declaratives ("i keep mixing up mitosis and meiosis every time").
# OFF here because local dev runs a CPU model where every classify call is
# seconds added to a message's critical path; flip it ON in a deployment whose
# LLM answers in milliseconds. Either way the failure direction is fixed: an
# unavailable or incoherent classifier resolves to `question`, the old
# behaviour, so this can never make chat worse than rules-only (D19, D23).
CHAT_INTENT_LLM_FALLBACK=false
# Rewrite a follow-up with the model instead of the deterministic fallback. Off for
# the same reason: it is a second serial generation, before retrieval even starts.
CHAT_CONDENSE_LLM=false
# Classify a book's kind/genre/summary at the end of ingest. Best effort: a failure
# leaves the columns null and changes nothing about retrieval.
BOOK_CLASSIFICATION_ENABLED=true

# --- Assessments -------------------------------------------------------------
# Chunks per LLM call. Batching lets the model see enough context not to ask the
# same thing twice within a batch; one call per question cannot.
ASSESSMENT_BATCH_CHUNKS=5
# Validation and dedupe reject some, so sample more chunks than questions wanted.
ASSESSMENT_OVERSAMPLE=1.5
# A chunk shorter than this cannot support a question worth asking.
ASSESSMENT_MIN_CHUNK_TOKENS=60
# Cosine similarity above which two stems are the same question.
ASSESSMENT_DEDUPE_SIMILARITY=0.92
# Generation and grading both spend money or CPU. Capped per user, per hour.
ASSESSMENT_RATE_LIMIT_PER_HOUR=10
# Hard ceiling on LLM calls per paper: one call per format first, then backfill from
# the formats that worked. A wall-clock budget, not a quality setting — on CPU-only
# Ollama a call is one to two minutes. Raise it when OPENAI_BASE_URL is something fast.
ASSESSMENT_MAX_LLM_CALLS=12
# Reply ceiling per generation call (Ollama: num_predict). Stops the runaway reply —
# eighteen questions for two asked — from burning minutes on output the validator
# rejects. A truncated batch is skipped and backfilled; an unbounded one is unbounded.
ASSESSMENT_REPLY_MAX_TOKENS=800
# Generation's own request timeout, above the general LLM_TIMEOUT_SECONDS: a batch
# prompt plus a full reply sits right at 120s on CPU, and dying at 119s with the
# answer nearly in hand, then retrying from zero, was where the minutes went.
ASSESSMENT_LLM_TIMEOUT_SECONDS=180
# A generating paper whose trace checkpoints stopped this long ago is dead: the
# worker was killed before its failure handler could write a reason. The
# maintenance sweep returns it to draft with one, so the spinner always resolves.
ASSESSMENT_STALE_AFTER_SECONDS=900
# Read the author's brief with a model call when the rules do not recognise it.
# Rules first, as with chat intent (D23) — "focus on chapter 3" is a pattern, not a
# judgement call — and off by default because on CPU it is another minute of spinner.
ASSESSMENT_BRIEF_LLM=false
# Chunks a named topic pulls into the pool, per topic. The brief narrows the pool; it
# never replaces it, because a paper still has to span the material.
ASSESSMENT_TOPIC_CHUNKS=30
# Ceiling on how much of a paper may be questions the BOOK asks rather than questions
# written for it. Not a target: a paper that is entirely back-of-chapter exercises is
# a photocopy. 0 disables harvesting; 1.0 lets a brief that asks for it have all of it.
ASSESSMENT_BOOK_QUESTION_SHARE=0.4
# Recognisable questions a chunk needs before it is worth a harvesting call. One stray
# question mark in a paragraph is not an exercise set, and harvesting from prose
# returns invented questions wearing a book's clothes.
ASSESSMENT_MIN_HARVEST_QUESTIONS=2

# --- Uploads (untrusted input — cap both) ------------------------------------
MAX_UPLOAD_MB=80
MAX_PAGE_COUNT=1200
ALLOWED_SOURCE_FORMATS=pdf,docx,pptx,txt,md,zip
# A ZIP is one book uploaded in parts (D26), combined at parse time. MAX_UPLOAD_MB
# bounds only the compressed bytes and a ZIP header's declared size is untrusted,
# so the decompressed total gets its own cap, enforced on the bytes produced.
ZIP_MAX_MEMBERS=64
ZIP_MAX_UNCOMPRESSED_MB=320

# --- Proctoring --------------------------------------------------------------
EVIDENCE_RETENTION_DAYS=60
HEARTBEAT_INTERVAL_SECONDS=15
# Silence longer than this becomes a heartbeat_gap event. Absence is evidence.
HEARTBEAT_GAP_SECONDS=60
# How often the browser flushes its event queue. Served to the client at session
# open, so capture cadence is a config change rather than a frontend release.
PROCTOR_EVENT_BATCH_SECONDS=10
# An active session silent this long is closed as 'aborted' by the sweep and
# aggregated, so an abandoned attempt still reaches the review queue.
PROCTOR_ABANDON_SECONDS=1800

# --- URLs / CORS -------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://backend:8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend (NEXT_PUBLIC_* is compiled into the browser bundle) ------------
# The browser cannot resolve host.docker.internal, so the public URL is 127.0.0.1
# while server-side rendering inside the container uses SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME=Kitaably
