meta {
  name: A non-owner cannot share a book
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/books/{{bookId}}/scope
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token2}}
}

body:json {
  {
    "shared": false
  }
}

assert {
  res.status: eq 404
}

tests {
  test("404, not 403", function () {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  The second user can *read* this book — it is in the shared library — but only its owner
  decides whether it stays there.

  Two layers say so: `require_book_owner` here, and the `books_update_own` policy on the
  write itself.
}
