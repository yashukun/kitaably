meta {
  name: A sitter cannot read the gradebook
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/assessments/{{assessmentId}}/attempts
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token2}}
}

assert {
  res.status: eq 404
}

tests {
  test("404, not 403", function () {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  Other people's results are not part of sitting a paper.
}
