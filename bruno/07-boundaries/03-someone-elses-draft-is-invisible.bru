meta {
  name: Someone elses draft is invisible
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/assessments/{{assessmentId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token2}}
}

assert {
  res.status: eq 404
}

tests {
  test("404, not 403", function () {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  The second user did not write this paper.

  404 rather than 403 throughout: a 403 on somebody else's row confirms the row exists.
  `errors.Forbidden` exists in the codebase and nothing raises it — that is evidence this
  rule is actually being followed, not an oversight.
}
