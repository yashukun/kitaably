meta {
  name: A sitter cannot release their own result
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/attempts/{{attemptId}}/release
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token2}}
}

assert {
  res.status: eq 404
}

tests {
  test("404, not 403", function () {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  Release is the author deciding a mark is ready to be seen. It is not self-service.
}
