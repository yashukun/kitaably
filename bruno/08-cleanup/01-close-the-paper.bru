meta {
  name: Close the paper
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/assessments/{{assessmentId}}/close
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.status: eq closed
}

docs {
  Stops accepting new sittings. Attempts already in progress keep the deadline they were
  given — closing a paper is not a way to cut somebody's time short.

  It lives in the cleanup folder for that reason: closing before `06-attempts` runs
would lock the sitter out before they ever open the link.
}
